---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Hero from "@components/home/Hero.astro";
import FeaturedWorks from "@components/home/FeaturedWorks.astro";
import CurrentOrbit from "@components/home/CurrentOrbit.astro";
import LatestWriting from "@components/home/LatestWriting.astro";
import { PROJECTS } from "../data/projects";
import { getFeaturedProjects, getLatestWriting } from "@utils/getHomeContent";
import "@styles/home.css";
const projects = getFeaturedProjects(PROJECTS);
const posts = getLatestWriting(await getCollection("blog"));
---

<Layout presentation="showcase" scrollSmooth>
  <Header wide />
  <main id="main-content" tabindex="-1" class="home-shell">
    <Hero />
    <FeaturedWorks {projects} />
    <div class="home-journal"><CurrentOrbit /><LatestWriting {posts} /></div>
  </main>
  <Footer wide />
</Layout>
<script>
  import "../scripts/portal";
</script>
