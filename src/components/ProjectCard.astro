---
import type { Project } from "../types.js";
import Icon from "./Icon.astro";
interface Props {
  project: Project;
}
const { project } = Astro.props;
const external = /^https?:\/\//.test(project.link);
const statusLabel = project.status
  ? { live: "已上线", beta: "Beta", archived: "已归档" }[project.status]
  : undefined;
const badge = project.visibility === "private" ? "私有仓库" : statusLabel;
---

<article class="project-card">
  <a
    href={project.link}
    target={external ? "_blank" : undefined}
    rel={external ? "noopener noreferrer" : undefined}
  >
    <div
      class:list={[
        "project-cover",
        { "contain-preview": project.imageFit === "contain" },
      ]}
    >
      <img
        src={project.image}
        alt={`${project.title} 项目预览`}
        width="960"
        height="400"
        loading="lazy"
        decoding="async"
        style={project.imagePosition
          ? `object-position: ${project.imagePosition}`
          : undefined}
      />
    </div>
    <div class="project-body">
      <div class="project-title">
        <h3>{project.title}</h3>{badge && <span>{badge}</span>}
      </div>
      <p>{project.description}</p>
      <div class="project-meta">
        <div class="project-tags">
          {project.tags.slice(0, 3).map(tag => <span># {tag}</span>)}
        </div><Icon name="arrow" />
      </div>
    </div>
    {
      external && (
        <span class="sr-only">
          {project.visibility === "private"
            ? "（私有仓库，需访问权限；在新标签页打开）"
            : "（在新标签页打开）"}
        </span>
      )
    }
  </a>
</article>
<style>
  .project-card {
    min-width: 0;
    border: 1px solid var(--line);
    background: rgba(var(--color-card), 0.45);
    transition:
      transform 200ms,
      border-color 200ms;
  }
  .project-card:hover {
    transform: translateY(-2px);
    border-color: rgba(var(--color-accent), 0.7);
  }
  .project-card a {
    height: 100%;
    display: flex;
    flex-direction: column;
  }
  .project-cover {
    aspect-ratio: 3 / 1;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
    background: rgb(var(--color-card));
  }
  .project-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    opacity: 0.84;
    transition: opacity 200ms;
  }
  .project-card:hover img {
    opacity: 1;
  }
  .contain-preview img {
    object-fit: contain;
    object-position: center;
  }
  .project-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 17px 20px;
  }
  .project-title {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    row-gap: 6px;
  }
  h3 {
    font-family: var(--font-display);
    font-size: 19px;
    letter-spacing: 0.04em;
    line-height: 1.4;
  }
  .project-title > span {
    color: rgb(var(--color-accent));
    font-size: 11px;
  }
  p {
    color: rgb(var(--muted));
    margin-top: 8px;
    font-size: 14px;
    line-height: 1.8;
  }
  .project-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: auto;
    padding-top: 20px;
    color: rgb(var(--color-accent));
  }
  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    font-size: 11px;
    letter-spacing: 0.05em;
    color: rgb(var(--muted));
  }
  @media (max-width: 767px) {
    .project-cover {
      aspect-ratio: 16 / 7;
    }
  }
</style>
