---
import { SITE } from "@config";
import Icon from "./Icon.astro";
interface Props {
  activeNav?: "posts" | "archives" | "tags" | "about" | "search" | "projects";
  wide?: boolean;
}
const { activeNav, wide = true } = Astro.props;
const links = [
  { id: "projects", label: "作品", href: "/projects/" },
  { id: "posts", label: "写作", href: "/posts/" },
  { id: "about", label: "关于", href: "/about/" },
];
---

<header class:list={["site-header", { wide }]}>
  <a class="skip-link" href="#main-content">跳到正文</a>
  <div class="header-inner">
    <a class="wordmark" href="/" aria-label="coolbat.xyz 首页">coolbat.xyz</a>
    <span class="brand-motto">以技术为舟，循星而行</span>
    <nav class="primary-nav" aria-label="主导航" id="primary-nav">
      {
        links.map(link => (
          <a
            href={link.href}
            aria-current={activeNav === link.id ? "page" : undefined}
          >
            {link.label}
          </a>
        ))
      }
      <a
        class="search-link"
        href="/search/"
        aria-label="搜索文章"
        aria-current={activeNav === "search" ? "page" : undefined}
        ><Icon name="search" /></a
      >
    </nav>
    <div class="header-actions">
      {
        SITE.lightAndDarkMode && (
          <button
            id="theme-btn"
            class="icon-button theme-button"
            type="button"
            aria-label="切换到浅色"
            title="切换到浅色"
          >
            <>
              <span class="theme-moon">
                <Icon name="moon" />
              </span>
              <span class="theme-sun">
                <Icon name="sun" />
              </span>
            </>
          </button>
        )
      }
      <button
        class="icon-button menu-button"
        type="button"
        data-menu-toggle
        aria-label="展开导航"
        aria-expanded="false"
        aria-controls="primary-nav"><Icon name="menu" /></button
      >
    </div>
  </div>
</header>
<style>
  .site-header {
    position: relative;
    z-index: 5;
    border-bottom: 1px solid var(--line);
  }
  .header-inner {
    position: relative;
    width: min(100% - 2rem, 48rem);
    margin-inline: auto;
    min-height: 80px;
    display: flex;
    align-items: center;
    gap: 26px;
  }
  .wide .header-inner {
    width: min(100% - 6rem, 85rem);
  }
  .wordmark {
    font-family: var(--font-display);
    font-size: 28px;
    letter-spacing: -0.035em;
    white-space: nowrap;
  }
  .brand-motto {
    display: none;
    border-left: 1px solid var(--line);
    padding-left: 24px;
    color: rgb(var(--muted));
    font-family: var(--font-display);
    font-size: 11px;
    letter-spacing: 0.18em;
    white-space: nowrap;
  }
  .wide .brand-motto {
    display: inline;
  }
  .primary-nav {
    display: flex;
    align-items: center;
    gap: 26px;
    margin-left: auto;
  }
  .primary-nav a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    font-size: 13px;
    letter-spacing: 0.12em;
    color: rgb(var(--muted));
    transition: color 180ms;
  }
  .primary-nav a:hover,
  .primary-nav a[aria-current="page"] {
    color: rgb(var(--color-accent));
  }
  .header-actions {
    display: flex;
    align-items: center;
  }
  .icon-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    color: rgb(var(--color-accent));
  }
  .theme-button {
    border-left: 1px solid var(--line);
  }
  .menu-button {
    display: none;
  }
  .skip-link {
    position: absolute;
    left: 1rem;
    top: -100px;
    padding: 12px 20px;
    background: rgb(var(--color-fill));
  }
  .skip-link:focus {
    top: 8px;
    z-index: 10;
  }
  @media (max-width: 1100px) {
    .wide .brand-motto {
      display: none;
    }
  }
  @media (max-width: 767px) {
    .header-inner,
    .wide .header-inner {
      width: calc(100% - 40px);
      min-height: 64px;
      gap: 12px;
      flex-wrap: wrap;
    }
    .wordmark {
      font-size: 24px;
    }
    .header-actions {
      margin-left: auto;
    }
    .primary-nav {
      width: 100%;
      order: 3;
      justify-content: space-between;
      gap: 8px;
      margin: 0;
      padding-bottom: 12px;
    }
    :global(html[data-js]) .primary-nav:not([data-open]) {
      display: none;
    }
    :global(html[data-js]) .menu-button {
      display: inline-flex;
    }
  }
</style>
<script>
  document.addEventListener("click", event => {
    if (!(event.target instanceof Element)) return;
    const button =
      document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
    const nav = document.querySelector("#primary-nav");
    if (!button || !nav) return;
    const open =
      event.target.closest("[data-menu-toggle]") &&
      !nav.hasAttribute("data-open");
    if (
      event.target.closest("[data-menu-toggle]") ||
      event.target.closest("a") ||
      !event.target.closest(".site-header")
    ) {
      nav.toggleAttribute("data-open", Boolean(open));
      button.setAttribute("aria-expanded", String(Boolean(open)));
      button.setAttribute("aria-label", open ? "收起导航" : "展开导航");
    }
  });
  document.addEventListener("keydown", event => {
    if (event.key !== "Escape") return;
    const nav = document.querySelector("#primary-nav[data-open]");
    if (!nav) return;
    nav.removeAttribute("data-open");
    const button =
      document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
    button?.setAttribute("aria-expanded", "false");
    button?.setAttribute("aria-label", "展开导航");
    button?.focus();
  });
</script>
