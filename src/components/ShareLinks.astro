---
interface Props {
  url: string;
  title: string;
}
const { url, title } = Astro.props;
const links = [
  {
    label: "X",
    href: `https://x.com/intent/post?${new URLSearchParams({ url, text: title })}`,
  },
  {
    label: "邮件",
    href: `mailto:?${new URLSearchParams({ subject: title, body: url })}`,
  },
  {
    label: "WhatsApp",
    href: `https://wa.me/?${new URLSearchParams({ text: `${title} ${url}` })}`,
  },
  {
    label: "Facebook",
    href: `https://www.facebook.com/sharer.php?${new URLSearchParams({ u: url })}`,
  },
  {
    label: "Telegram",
    href: `https://t.me/share/url?${new URLSearchParams({ url, text: title })}`,
  },
  {
    label: "Pinterest",
    href: `https://pinterest.com/pin/create/button/?${new URLSearchParams({ url, description: title })}`,
  },
];
---

<div class="share-links">
  <button type="button" data-copy-link={url}>复制链接</button>
  <details class="share-menu">
    <summary>分享文章 <span aria-hidden="true">↗</span></summary><nav
      aria-label="分享文章"
    >
      {
        links.map(link => (
          <a href={link.href} target="_blank" rel="noopener noreferrer">
            {link.label}
            <span class="sr-only">（在新标签页打开）</span>
          </a>
        ))
      }
    </nav>
  </details>
</div>
