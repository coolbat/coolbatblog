---
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import ArticleToc from "@components/ArticleToc.astro";
import ShareLinks from "@components/ShareLinks.astro";
import ContactLinks from "@components/ContactLinks.astro";
import type { CollectionEntry } from "astro:content";
import { slugifyStr } from "@utils/slugify";
import { formatHomeDate } from "@utils/getHomeContent";
import { SITE } from "@config";

export interface Props {
  post: CollectionEntry<"blog">;
  posts: CollectionEntry<"blog">[];
}
const { post, posts } = Astro.props;
const {
  title,
  author,
  description,
  ogImage,
  canonicalURL,
  pubDatetime,
  modDatetime,
  tags,
  editPost,
} = post.data;
const { Content, headings } = await post.render();
const tocHeadings = headings.filter(
  heading =>
    heading.depth >= 2 &&
    heading.depth <= 3 &&
    heading.slug !== "table-of-contents"
);
const ogImageUrl = typeof ogImage === "string" ? ogImage : ogImage?.src;
const shareURL = canonicalURL ?? new URL(Astro.url.pathname, SITE.website).href;
const ogUrl = new URL(
  ogImageUrl ?? `/posts/${slugifyStr(title)}.png`,
  Astro.url.origin
).href;
const currentPostIndex = posts.findIndex(item => item.slug === post.slug);
const prevPost = currentPostIndex > 0 ? posts[currentPostIndex - 1] : undefined;
const nextPost =
  currentPostIndex >= 0 ? posts[currentPostIndex + 1] : undefined;
const editBase = editPost?.url ?? SITE.editPost?.url;
const editURL =
  editBase && !editPost?.disabled
    ? `${editBase}${(editPost?.appendFilePath ?? SITE.editPost?.appendFilePath) ? `/${post.id}` : ""}`
    : undefined;
---

<Layout
  title={`${title} | ${SITE.title}`}
  {author}
  {description}
  {pubDatetime}
  {modDatetime}
  {canonicalURL}
  ogImage={ogUrl}
  scrollSmooth
>
  <Header activeNav="posts" />
  <div class="reading-progress" aria-hidden="true">
    <div id="reading-progress"></div>
  </div>
  <main id="main-content" class="interior-shell article-page" tabindex="-1">
    <nav class="interior-breadcrumb" aria-label="面包屑">
      <a href="/">首页</a><span aria-hidden="true">/</span><a href="/posts/"
        >写作</a
      ><span aria-hidden="true">/</span><span aria-current="page">{title}</span>
    </nav>
    <header class="article-intro">
      <p class="eyebrow">
        <span class="small-star" aria-hidden="true">✧</span><span lang="en"
          >Notes & reflections</span
        >
      </p>
      <h1 id="article-top" tabindex="-1" transition:name={slugifyStr(title)}>
        {title}
      </h1>
      <p class="article-deck">{description}</p>
      <div class="article-meta">
        <span class="article-author">{author}</span><span
          >发布于 <time datetime={pubDatetime.toISOString()}
            >{formatHomeDate(pubDatetime)}</time
          ></span
        >{
          modDatetime && modDatetime > pubDatetime && (
            <span>
              更新于{" "}
              <time datetime={modDatetime.toISOString()}>
                {formatHomeDate(modDatetime)}
              </time>
            </span>
          )
        }{
          editURL && (
            <a href={editURL} target="_blank" rel="noopener noreferrer">
              {editPost?.text ?? SITE.editPost?.text ?? "编辑文章"}
            </a>
          )
        }
      </div>
    </header>
    {
      tocHeadings.length > 0 && (
        <details class="mobile-toc">
          <>
            <summary>
              本篇目录 <span aria-hidden="true">＋</span>
            </summary>
            <ArticleToc headings={tocHeadings} />
          </>
        </details>
      )
    }
    <div class="article-layout">
      <div class="article-main">
        <article
          id="article"
          class="reading-prose"
          data-has-toc={tocHeadings.length > 0 ? "true" : undefined}
        >
          <Content />
        </article>
        <div class="article-end">
          <ul class="article-tags" aria-label="文章标签">
            {
              tags.map(tag => (
                <li>
                  <a href={`/tags/${slugifyStr(tag)}/`}># {tag}</a>
                </li>
              ))
            }
          </ul>
          <div class="article-actions">
            <ShareLinks url={shareURL} {title} /><a
              class="back-to-top"
              href="#article-top"
              data-back-top>回到顶部 <span aria-hidden="true">↑</span></a
            >
          </div>
          <p class="article-feedback sr-only" role="status" aria-live="polite">
          </p>
          {
            (prevPost || nextPost) && (
              <nav class="adjacent-posts" aria-label="继续阅读">
                {prevPost && (
                  <a href={`/posts/${prevPost.slug}/`}>
                    <span>上一篇</span>
                    <p>{prevPost.data.title}</p>
                  </a>
                )}
                {nextPost && (
                  <a class="next-post" href={`/posts/${nextPost.slug}/`}>
                    <span>下一篇</span>
                    <p>{nextPost.data.title}</p>
                  </a>
                )}
              </nav>
            )
          }
          <a href="/posts/" class="return-writing"
            ><span aria-hidden="true">←</span> 返回全部写作</a
          >
        </div>
      </div>
      <aside class="article-sidebar">
        {
          tocHeadings.length > 0 && (
            <div class="sticky-outline">
              <>
                <p class="eyebrow" lang="en">
                  On this page
                </p>
                <h2>本篇目录</h2>
                <ArticleToc headings={tocHeadings} />
                <p class="outline-note">
                  把问题读深，
                  <br />
                  把思考留在途中。
                </p>
              </>
            </div>
          )
        }
      </aside>
    </div>
    <section class="interior-contact" aria-labelledby="article-contact-title">
      <div>
        <p class="eyebrow" lang="en">From Coolbat</p><h2
          id="article-contact-title"
        >
          阅读之后，继续交流。
        </h2><p>这里是 Coolbat 的个人主页。欢迎聊聊代码、工具与创作。</p>
      </div><ContactLinks compact />
    </section>
  </main>
  <Footer />
</Layout>
<script>
  import "../scripts/article";
</script>
